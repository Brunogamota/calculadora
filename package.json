{
  "name": "raio-x-checkout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Raio-X do Checkout — motor de auditoria",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "preflight": "tsx apps/worker/src/cli.ts preflight",
    "detect": "tsx apps/worker/src/cli.ts detect",
    "audit": "tsx apps/worker/src/cli.ts audit",
    "smoke": "tsx apps/worker/scripts/smoke-browser.ts",
    "sniff": "tsx apps/worker/scripts/sniff-html.ts",
    "test": "node --import tsx --test apps/worker/test/*.test.ts packages/*/test/*.test.ts",
    "test:e2e": "node --import tsx --test apps/worker/test/e2e/*.test.ts",
    "test:all": "npm test && npm run test:e2e",
    "typecheck": "tsc -p apps/worker --noEmit && tsc -p packages/types --noEmit"
  },
  "dependencies": {
    "playwright": "1.56.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
