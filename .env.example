# Identidade usada para preencher contato e entrega no checkout (§6.5).
#
# Copie para .env e preencha. O .env está no .gitignore e NUNCA deve ser
# commitado: o que vai aqui é dado pessoal real, e repositório Git guarda
# histórico para sempre.
#
# Atenção ao que isso significa na prática: cada auditoria com preenchimento
# deixa estes dados no admin da loja auditada, como checkout abandonado. Use
# em loja própria, ou com consciência de que o dado fica com o lojista.
#
# O motor NUNCA gera CPF nem inventa identidade. Sem estas variáveis, a etapa
# de checkout não roda e sai como não aplicável.

AUDIT_NAME=Nome Sobrenome
AUDIT_EMAIL=auditoria@exemplo.com
AUDIT_PHONE=(11) 90000-0000
AUDIT_POSTAL_CODE=00000-000
AUDIT_ADDRESS=Rua Exemplo
AUDIT_ADDRESS_NUMBER=100
AUDIT_CITY=São Paulo
# Opcional. Se ausente, o campo de CPF é apenas observado, sem preenchimento.
AUDIT_CPF=000.000.000-00

# Já existentes
AUDIT_USER_AGENT=RebornCheckoutAudit/1.0 (+https://rebornpay.io/raio-x)
MAX_AUDIT_MS=120000
